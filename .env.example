# Optional: Gnani speech recognition (STT) and speech output (TTS)
GNANI_API_KEY=
# Optional: override the Timbre REST endpoint (Prisma STT remains independently configured).
GNANI_TTS_URL=https://api.vachana.ai/api/v1/tts/inference
# Optional: Groq handles reasoning only. Get a key at https://console.groq.com/keys
GROQ_API_KEY=
# Current default; change to a model available to your account.
GROQ_MODEL=openai/gpt-oss-120b
# Optional tuning. Values are clamped by ORACLE.
ORACLE_POLL_INTERVAL=3
ORACLE_EVENT_RETENTION_DAYS=30
ORACLE_MAX_EVENTS=10000
ORACLE_MAX_INVESTIGATIONS=2000
# Local resource history: system metrics every 5s; selected process metrics every 15s.
ORACLE_RESOURCE_INTERVAL=5
ORACLE_PROCESS_RESOURCE_INTERVAL=15
ORACLE_RESOURCE_RETENTION_HOURS=24
ORACLE_MAX_RESOURCE_PROCESSES=64
# Local detector baseline and cooldown tuning.
ORACLE_MINIMUM_OBSERVATION_MINUTES=2
ORACLE_MINIMUM_BASELINE_SAMPLES=6
ORACLE_CPU_SENSITIVITY=3.0
ORACLE_MEMORY_GROWTH_PERCENT=30
ORACLE_ALERT_COOLDOWN_SECONDS=300
# Optional: ORACLE_DB=/absolute/path/to/oracle.db
